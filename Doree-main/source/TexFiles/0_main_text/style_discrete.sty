%%%%% ENVIRONMENTS %%%%%

% OBJECT ENVIRONMENTS
    \theoremstyle{definition}

    \newcounter{cbs}[section] % cbs = count by section, restarts count each section (vs. book, chapter, or subsection)
    \renewcommand{\thecbs}{\thesection.\arabic{cbs}} % to include the section number so format will be Activity 1.1.1, Example 1.1.2, Theorem 1.1.3 etc.
    % All of the following environments to share a numbering: Theorem, Definition, Example, Remark, Activity
    % Figure, Table are different in that they are counted within the larger structure -- so if Example 1.2.9 has a figure, it will be called 1.2.9.1 and so on. While I don't love this, it does help connect the figure back to the relevant Definition, Example, Activity, so it's not terrible.

    \newtheorem{thm}[cbs]{Theorem}  % Theorem is a defined environment.  Listing it here just to nickname ``thm'' so other things can be counted with it. Theorems will be cite often later in the course.  Label has the form thm_arg2
    
    \newtheorem{defn}[cbs]{Definition} % Label has the form defn_arg2 .  
    
    \newtheorem{exam}[cbs]{Example} % Label has the form exam_arg2

    \newtheorem{rem}[cbs]{Remark} % Remarks are often about conventions in mathematics (e.g. leaving answers unsimplified).  Label has the form rem_arg2

    \newtheorem{pff}[cbs]{Proof Format} % Proof Formats are logical outlines of formats of proofs.   Label has the form pff_arg2
    
    %\newtheorem{oact}[cbs]{Opening Activity} % Label has the form oact_arg2   WILL NO LONGER BE USED

    \newtheorem{act}[cbs]{Activity}
     %Label has the form act_arg2

     %\newtheorem{cact}[cbs]{Summary Activityt}% WILL NO LONGER BE USED

    \counterwithin{figure}{section} 
    %\counterwithin{figure}{cbs} % Using cbs in this command numbers the figures within examples, which is nice, but then all of the figures in the exercises are numbered with ch.sec.lastvaluecbs.arabic, which is unweildy. 
    %Figure is an established environment (not redefined here). Label has the form fig_arg2
   
    \counterwithin{table}{section} 
    %\counterwithin{table}{cbs} 
    % Using cbs creates issues -- seefigures.
    %Table is an established environment (not redefined here).   Label has the form table_arg2
    %%\counterwithin*{table}{cbs}

    \newtheorem{exer}{Exercise}[] % Label has the form exer_arg2 where arg2 is inside the second set of braces 
    \counterwithin*{exer}{section}
    % End-of-section Exercises restart the numbering and are just Exercise 1, Exercise 2, . . . I have to manually Cref the section if I refer to an exercise from a different section.

    % To sort the type of exercises we use:
    \newcommand{\exerR}{Recap}
    \newcommand{\exerP}{Practice}
    \newcommand{\exerU}{Understand}
    \newcommand{\exerE}{Explore}

    % If I want to sort the activities (prob not puzzles)
    % \newcommand{\actP}{P}
    % \newcommand{\actU}{U}
    % \newcommand{\actE}{E}

    \newtheorem*{soln}{Solution} %Unlabelled NOTE: Unnumbered environment
    \AtEndEnvironment{soln}{\qed} %puts an open box at the end of  solution

