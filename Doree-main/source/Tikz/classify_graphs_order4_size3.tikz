% P_4 bent
\begin{tikzpicture}
[scale =.35]
\GraphInit[vstyle=Welsh]
\SetGraphUnit{1.6}
\SetVertexNoLabel
\node at (1.5,-2) {$2, 2, 1,1$};
\Vertex[LabelOut,Lpos=90,x=0,y=3]{$A$}
\Vertex[LabelOut,Lpos= 90,x=3,y=3]{$B$}
\Vertex[LabelOut,Lpos=-90,x=3,y=0]{$C$}
\Vertex[LabelOut,Lpos=-90,x=0,y=0]{$D$}
\Edges($D$,$A$, $B$,$C$)
\end{tikzpicture}