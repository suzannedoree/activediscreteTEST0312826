\begin{tikzpicture}
    [scale =.5]
    \GraphInit[vstyle=Welsh]
    \SetGraphUnit{2}
    \SetVertexNoLabel
% W4
    \Vertices{circle}{a,b,c,d}
    \Vertex[x=0,y=0]{z}
    \Edges(a,b,c,d,a)
    \Edges(a,z,b)
    \Edges(c,z,d)
\end{tikzpicture}
