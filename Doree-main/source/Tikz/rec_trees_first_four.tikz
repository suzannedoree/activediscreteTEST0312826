%Used in \Cref{oact_rec_trees}.

\begin{tikzpicture} 
    [scale =.5]
    \GraphInit[vstyle=Welsh]
    \SetGraphUnit{2}
    \SetVertexNoLabel
    %T1
    \Vertex[x=0,y=6]{a}
    %T2
    \Vertex[x=4,y=6]{b}
    %T3
    \Vertex[x=10,y=6]{c}
        %Left
        \Vertex[x=9,y=4]{p}
        % Right
        \Vertex[x=11,y=4]{q}
        \Edges(p,c,q)
    %T4
    \Vertex[x=18,y=6]{d}
        %Left
        \Vertex[x=17,y=4]{r}
            %Subleft
            \Vertex[x=16,y=2]{w}
            %Subright
            \Vertex[x=18,y=2]{x} 
            \Edges(w,r,x)
        % Right
        \Vertex[x=19,y=4]{s}
        \Edges(r,d,s)
    %T5
    \Vertex[x=28,y=6]{e}
        %Left
        \Vertex[x=26,y=4]{t}
            %Subleft
            \Vertex[x=25,y=2]{y}
                %Subsubleft
                    \Vertex[x=24,y=0]{i}
                %Subsubright
                    \Vertex[x=26,y=0]{j}   
                    \Edges(i,y,j)
            %Subright
            \Vertex[x=27,y=2]{z} 
            \Edges(y,t,z)
        % Right
        \Vertex[x=30,y=4]{u}
            %Left
            \Vertex[x=29,y=2]{m}
            %Left
            \Vertex[x=31,y=2]{n}
            \Edges(m,u,n)
        \Edges(t,e,u)   
\end{tikzpicture}
