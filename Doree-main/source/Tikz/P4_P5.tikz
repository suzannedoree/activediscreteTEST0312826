\begin{tikzpicture}
    [scale =.5]
    \GraphInit[vstyle=Welsh]
    \SetGraphUnit{2}
    \SetVertexNoLabel
% P4
    \Vertex[LabelOut,Lpos=90,x=0,y=0]{a}
    \Vertex[LabelOut,Lpos=90,x=1.5,y=0]{b} 
    \Vertex[LabelOut,Lpos=90,x=3,y=0]{c}
    \Vertex[LabelOut,Lpos=90,x=4.5,y=0]{d}
    \Edges(a,b,c,d)
\end{tikzpicture}
