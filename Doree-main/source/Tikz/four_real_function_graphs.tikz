%Used in \Cref{sec_onetoone_onto_fns}.

%%% y = x^2
\begin{tikzpicture}[x=.4cm, y=0.15cm]
  \begin{scope}[shift={(0,0)}]
    \draw[->] (-3.4,0) -- (3.4,0) node[right] {$x$};
    \draw[->] (0,-16) -- (0,16) node[above] {$y$};
    \foreach \n in {-3,-2,-1,1,2,3} {
      \draw (\n,-0.4) -- (\n,0.4) node[below=6pt, anchor=north east, xshift=2pt] {$\n$};
    }
    \foreach \y in {-15,-10,-5,5,10,15} {
      \draw (-0.12,\y) -- (0.12,\y) node[left=4pt] {$\y$};
    }
    \draw[very thick, blue, domain=-4:4, samples=100] plot (\x, {(\x)^2});
  \end{scope}
  \end{tikzpicture}
 \hspace{.15in}
 %%% y = x^3-2x+1
\begin{tikzpicture}[x=.4cm, y=0.15cm]
  \begin{scope}[shift={(0,0)}]
    \draw[->] (-3.4,0) -- (3.4,0) node[right] {$x$};
    \draw[->] (0,-16) -- (0,16) node[above] {$y$};
    \foreach \n in {-3,-2,-1,1,2,3} {
      \draw (\n,-0.4) -- (\n,0.4) node[below=6pt, anchor=north east, xshift=2pt] {$\n$};
    }
    \foreach \y in {-15,-10,-5,5,10,15} {
      \draw (-0.12,\y) -- (0.12,\y) node[left=4pt] {$\y$};
    }
    \draw[very thick, blue, domain=-2.9:2.9, samples=100] plot (\x, {(\x)^3 -2*\x+1});
  \end{scope}
  \end{tikzpicture}
 \hspace{.15in}
 %%% y = 2^x
\begin{tikzpicture}[x=.4cm, y=0.15cm]
  \begin{scope}[shift={(0,0)}]
    \draw[->] (-3.4,0) -- (3.4,0) node[right] {$x$};
    \draw[->] (0,-16) -- (0,16) node[above] {$y$};
    \foreach \n in {-3,-2,-1,1,2,3} {
      \draw (\n,-0.4) -- (\n,0.4) node[below=6pt, anchor=north east, xshift=2pt] {$\n$};
    }
    \foreach \y in {-15,-10,-5,5,10,15} {
      \draw (-0.12,\y) -- (0.12,\y) node[left=4pt] {$\y$};
    }
    \draw[very thick, blue, domain=-4:4, samples=100] plot (\x, {2^(\x)});
  \end{scope}
  \end{tikzpicture}
 \hspace{.15in}
 %%% y = x^3
\begin{tikzpicture}[x=.4cm, y=0.15cm]
  \begin{scope}[shift={(0,0)}]
    \draw[->] (-3.4,0) -- (3.4,0) node[right] {$x$};
    \draw[->] (0,-16) -- (0,16) node[above] {$y$};
    \foreach \n in {-3,-2,-1,1,2,3} {
      \draw (\n,-0.4) -- (\n,0.4) node[below=6pt, anchor=north east, xshift=2pt] {$\n$};
    }
    \foreach \y in {-15,-10,-5,5,10,15} {
      \draw (-0.12,\y) -- (0.12,\y) node[left=4pt] {$\y$};
    }
    \draw[very thick, blue, domain=-2.6:2.7, samples=100] plot (\x, {(\x)^3 });
  \end{scope}
\end{tikzpicture}