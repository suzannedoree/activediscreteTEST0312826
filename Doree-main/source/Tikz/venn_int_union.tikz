%%Used in \Cref{sub_set_operations}.

%%
%% Intersection
%%
\begin{minipage} {.4\textwidth}
\begin{center}
\begin{tikzpicture}[fill=blue!25!gray]
% left hand
\scope
\clip (1,0) circle (1);
\fill (0,0) circle (1);
\endscope
% right hand
\scope
\clip (0,0) circle (1);
\fill (1,0) circle (1);
\endscope
% outline
\draw (0,0) circle (1) (-1,.75)  node [text=black,above] {$S$}
      (1,0) circle (1) (2, .75)  node [text=black,above] {$T$}
     (.5,1.5) node [text=black,above] {$S \cap T$};
\end{tikzpicture}
\end{center}
\end{minipage}
%%
%% Union
%%
\begin{minipage} {.4\textwidth}
\begin{center}
\begin{tikzpicture}[fill=blue!25!gray]
% left hand
\scope
\clip (1,0) circle (1);
\fill (1,0) circle (1);
\endscope
% right hand
\scope
\clip (0,0) circle (1);
\fill (0,0) circle (1);
\endscope
% outline
\draw (0,0) circle (1) (-1,.75)  node [text=black,above] {$S$}
      (1,0) circle (1) (2, .75)  node [text=black,above] {$T$}
     (.5,1.5) node [text=black,above] {$S \cup T$};
\end{tikzpicture}
\end{center}
\end{minipage}