%Used in \Cref{sec_graph_ism}

\begin{tikzpicture}
[scale =.5, auto=left]
\GraphInit[vstyle=Welsh]
\SetGraphUnit{1.6}
%\SetVertexNoLabel
\node at (0,4) {$\overline{G}$ labeled};
\Vertices{circle}{$c$,$u$,$b$,$v$,$z$,$a$}
\Edges($v$,$a$,$b$,$c$)
\Edges($u$,$a$)
\end{tikzpicture}
\hspace{.5in} %%%%%%%%%
\begin{tikzpicture}
[scale =.5, auto=left]
\GraphInit[vstyle=Welsh]
\SetGraphUnit{1.6}
%\SetVertexNoLabel
\node at (0,4) {$\overline{H}$ labeled};
\Vertices{circle}{$z$,$b$,$u$,$v$,$c$,$a$}
