%% Venn diagrams of the symmetric difference and each difference.
%%Used in \Cref{sub_set_operations}.

%% 
%% SYM DIFF
%%
\begin{minipage} {.3\textwidth}
\begin{center}
\begin{tikzpicture}[fill=blue!25!gray]
% left hand
\scope
\clip (-2,-2) rectangle (2,2)
      (1,0) circle (1);
\fill (0,0) circle (1);
\endscope
% right hand
\scope
\clip (-2,-2) rectangle (2,2)
      (0,0) circle (1);
\fill (1,0) circle (1);
\endscope
% outline
\draw (0,0) circle (1) (-1,.75)  node [text=black,above] {$S$}
      (1,0) circle (1) (2, .75)  node [text=black,above] {$T$}
     (.5,1.5) node [text=black,above] {$S \oplus T$};
\end{tikzpicture}
\end{center}
\end{minipage}
%%
%% LEFT WING
%%
\begin{minipage} {.3\textwidth}
\begin{center}
\begin{tikzpicture}[fill=blue!25!gray]
% left hand
\scope
\clip (-2,-2) rectangle (2,2)
      (1,0) circle (1);
\fill (0,0) circle (1);
\endscope
% right hand
\scope
\clip (-2,-2) rectangle (2,2)
      (0,0) circle (1);
%\fill (1,0) circle (1);
\endscope
% outline
\draw (0,0) circle (1) (-1,.75)  node [text=black,above] {$S$}
      (1,0) circle (1) (2, .75)  node [text=black,above] {$T$}
     (.5,1.5) node [text=black,above] {$S - T$};
\end{tikzpicture}
\end{center}
\end{minipage}
%%
%% RIGHT WING
%%
\begin{minipage} {.3\textwidth}
\begin{center}
\begin{tikzpicture}[fill=blue!25!gray]
% left hand
\scope
\clip (-2,-2) rectangle (2,2)
      (1,0) circle (1);
%\fill (0,0) circle (1);
\endscope
% right hand
\scope
\clip (-2,-2) rectangle (2,2)
      (0,0) circle (1);
\fill (1,0) circle (1);
\endscope
% outline
\draw (0,0) circle (1) (-1,.75)  node [text=black,above] {$S$}
      (1,0) circle (1) (2, .75)  node [text=black,above] {$T$}
     (.5,1.5) node [text=black,above] {$T-S$};
\end{tikzpicture}
\end{center}
\end{minipage}

