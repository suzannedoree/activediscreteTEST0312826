% Used in \Cref{sec_graph_ism}.

\begin{tikzpicture}
[scale =.5]
\GraphInit[vstyle=Welsh]
\SetGraphUnit{1.6}
\SetVertexNoLabel
\Vertices{circle}{$a$,$b$,$c$,$d$,$e$,$r$}
\Edges($a$, $b$, $c$, $d$, $e$,$r$,$a$)
\Edges($c$,$r$)
\Edges($b$,$e$)
\Edges($a$,$d$)
\end{tikzpicture}
