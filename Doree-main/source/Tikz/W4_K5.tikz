%Used in \Cref{sec_graph_thy}.

%The wheeel $W_4$
\begin{tikzpicture}
    [scale =.5]
    \GraphInit[vstyle=Welsh]
    \SetGraphUnit{2}
    %\SetVertexNoLabel
    \Vertices{circle}{$b$,$a$,$d$,$c$}
    \Vertex[LabelOut,Lpos=35,x=0,y=0]{$x$}
    \Edges($a$,$b$,$c$,$d$,$a$)
    \Edges($a$,$x$,$b$)
    \Edges($c$,$x$,$d$)
\end{tikzpicture}
\hspace{1in}
%The complete graph $K_5$
\begin{tikzpicture}
    [scale =.5]
    \GraphInit[vstyle=Welsh]
    \SetGraphUnit{2}
    %\SetVertexNoLabel
    \Vertices{circle}{$b$,$a$,$e$,$d$,$c$}
    \Edges($a$,$b$,$c$,$d$,$e$,$a$)
    \Edges($a$,$c$,$e$,$b$,$d$,$a$)
\end{tikzpicture}