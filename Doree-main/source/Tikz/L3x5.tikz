

%Used in \Cref{sec_graph_models}.
% Lattice $L_{3 \times 5}$$
\begin{tikzpicture}
    [scale =.5]
    \GraphInit[vstyle=Welsh]
    \SetGraphUnit{2}
        \SetVertexNoLabel
    % bottom row
    \Vertex[LabelOut,Lpos=90,x=0,y=0]{a1}
    \Vertex[
    LabelOut,Lpos=90,x=1.5,y=0]{b1} 
    \Vertex[LabelOut,Lpos=90,x=3,y=0]{c1}
    \Vertex[LabelOut,Lpos=90,x=4.5,y=0]{d1}    
    \Vertex[LabelOut,Lpos=90,x=6,y=0]{e1}
    \Edges(a1,b1,c1,d1,e1)
    % middle row
    \Vertex[LabelOut,Lpos=90,x=0,y=1.5]{a2}
    \Vertex[LabelOut,Lpos=90,x=1.5,y=1.5]{b2} 
    \Vertex[LabelOut,Lpos=90,x=3,y=1.5]{c2}
    \Vertex[LabelOut,Lpos=90,x=4.5,y=1.5]{d2}    
    \Vertex[LabelOut,Lpos=90,x=6,y=1.5]{e2}
    \Edges(a2,b2,c2,d2,e2)
    % top row
    \Vertex[LabelOut,Lpos=90,x=0,y=3]{a3}
    \Vertex[LabelOut,Lpos=90,x=1.5,y=3]{b3} 
    \Vertex[LabelOut,Lpos=90,x=3,y=3]{c3}
    \Vertex[LabelOut,Lpos=90,x=4.5,y=3]{d3}    
    \Vertex[LabelOut,Lpos=90,x=6,y=3]{e3}
    \Edges(a3,b3,c3,d3,e3)
    % vertical edges
    \Edges(a1,a2,a3)
    \Edges(b1,b2,b3)
    \Edges(c1,c2,c3)
    \Edges(d1,d2,d3)
    \Edges(e1,e2,e3)
\end{tikzpicture}