% G
\begin{tikzpicture}
[scale =.5]
\GraphInit[vstyle=Welsh]
\SetGraphUnit{1.6}
%\SetVertexNoLabel
\node at (0,3) {$G$};
\Vertices{circle}{$c$,$b$, $a$, $f$,$e$, $d$}
\Edges($a$, $b$, $c$, $d$, $e$,$a$)
\Edges($c$,$f$)
\Edges($e$,$b$,$d$)
\end{tikzpicture}
