\Vertex[LabelOut,Lpos=90,x=0,y=0]{$a$}
\Vertex[LabelOut,Lpos= 90,x=2,y=0]{$b$}
\Vertex[LabelOut,Lpos= 90,x=4,y=0]{$c$}
\Vertex[LabelOut,Lpos= 90,x=6,y=0]{$d$}
\Vertex[LabelOut,Lpos= 90,x=8,y=0]{$e$}
\Vertex[LabelOut,Lpos= 90,x=10,y=0]{$f$}
