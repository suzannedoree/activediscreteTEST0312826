% Used in \Cref{figure_show_not_set}.

\begin{tikzpicture}[x=1cm,y=1cm]
  \definecolor{setgreen}{RGB}{40,150,70}
  \definecolor{setpurple}{RGB}{120,70,170}
  \definecolor{setred}{RGB}{190,60,60}
  \foreach \x/\label in {0.0/1FGD,2.6/1NPD,5.2/1NRD} {
    \draw[rounded corners=0.2cm] (\x,0) rectangle (\x+2.2,3.2);
    \node[font=\scriptsize] at (\x+1.1,2.95) {\texttt{\label}};
  }
  \fill[setgreen] (1.1,2.05) -- (1.55,1.6) -- (1.1,1.15) -- (0.65,1.6) -- cycle;
  \draw[setpurple] (3.7,2.05) -- (4.15,1.6) -- (3.7,1.15) -- (3.25,1.6) -- cycle;
  \draw[setred] (6.3,2.05) -- (6.75,1.6) -- (6.3,1.15) -- (5.85,1.6) -- cycle;
\end{tikzpicture}