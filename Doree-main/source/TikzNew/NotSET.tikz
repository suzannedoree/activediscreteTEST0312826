% Used in \Cref{figure_show_not_set}.

\begin{tikzpicture}[x=0.85cm,y=1.1cm]
  \definecolor{setgreen}{RGB}{0,192,64}
  \definecolor{setpurple}{RGB}{128,0,192}
  \definecolor{setred}{RGB}{192,0,0}
  
  % Three card backgrounds
  \foreach \i in {0,1,2} {
    \draw[rounded corners=0.12cm,line width=0.04cm] ({3.2*\i},0) rectangle ({3.2*\i+3},4);
  }
  
  % Labels
  \node[font=\tiny\ttfamily] at (0.2,3.75) {\tiny 1FGD};
  \node[font=\tiny\ttfamily] at (3.4,3.75) {\tiny 1NPD};
  \node[font=\tiny\ttfamily] at (6.6,3.75) {\tiny 1NRD};
  
  % Card 1: 1 Full green diamond
  \fill[setgreen] (0.75,1.5) -- (1.15,2.0) -- (0.75,2.5) -- (0.35,2.0) -- cycle;
  \draw[setgreen,line width=0.07cm] (0.75,1.5) -- (1.15,2.0) -- (0.75,2.5) -- (0.35,2.0) -- cycle;
  
  % Card 2: 1 None purple diamond (open)
  \draw[setpurple,line width=0.07cm] (3.95,1.5) -- (4.35,2.0) -- (3.95,2.5) -- (3.55,2.0) -- cycle;
  
  % Card 3: 1 None red diamond (open)
  \draw[setred,line width=0.07cm] (7.15,1.5) -- (7.55,2.0) -- (7.15,2.5) -- (6.75,2.0) -- cycle;
\end{tikzpicture}