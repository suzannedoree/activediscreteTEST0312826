% Used in \Cref{figure_decide_if_set}.

\begin{tikzpicture}[x=1cm,y=1cm]
  \definecolor{setgreen}{RGB}{40,150,70}
  \definecolor{setpurple}{RGB}{120,70,170}
  \definecolor{setred}{RGB}{190,60,60}
  \foreach \x/\label in {0.0/1SGQ,2.6/2SPO,5.2/3SRD} {
    \draw[rounded corners=0.2cm] (\x,0) rectangle (\x+2.2,3.2);
    \node[font=\scriptsize] at (\x+1.1,2.95) {\texttt{\label}};
  }
  \draw[setgreen,pattern=north east lines,pattern color=setgreen,line width=0.8pt] (0.6,1.9) .. controls (0.9,2.1) and (1.3,1.7) .. (1.6,1.9)
    .. controls (1.3,1.5) and (0.9,1.7) .. (0.6,1.5)
    .. controls (0.9,1.2) and (1.3,1.6) .. (1.6,1.5);
  \draw[setpurple,pattern=north east lines,pattern color=setpurple] (3.7,2.05) ellipse (0.55 and 0.22);
  \draw[setpurple,pattern=north east lines,pattern color=setpurple] (3.7,1.15) ellipse (0.55 and 0.22);
  \draw[setred,pattern=north east lines,pattern color=setred] (6.3,2.25) -- (6.75,1.8) -- (6.3,1.35) -- (5.85,1.8) -- cycle;
  \draw[setred,pattern=north east lines,pattern color=setred] (6.3,1.95) -- (6.75,1.5) -- (6.3,1.05) -- (5.85,1.5) -- cycle;
  \draw[setred,pattern=north east lines,pattern color=setred] (6.3,1.65) -- (6.75,1.2) -- (6.3,0.75) -- (5.85,1.2) -- cycle;
\end{tikzpicture}