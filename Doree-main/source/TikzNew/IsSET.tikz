% Used in \Cref{figure_show_set}.

\begin{tikzpicture}[x=0.85cm,y=1.1cm]
  \definecolor{setred}{RGB}{192,0,0}
  
  % Three card backgrounds
  \foreach \i in {0,1,2} {
    \draw[rounded corners=0.12cm,line width=0.04cm] ({3.2*\i},0) rectangle ({3.2*\i+3},4);
  }
  
  % Labels
  \node[font=\tiny\ttfamily] at (0.2,3.75) {\tiny 2NRO};
  \node[font=\tiny\ttfamily] at (3.4,3.75) {\tiny 2SRO};
  \node[font=\tiny\ttfamily] at (6.6,3.75) {\tiny 2FRO};
  
  % Card 1: 2 None ovals (open outline only)
  \foreach \y in {2.7,1.5} {
    \draw[setred,line width=0.07cm] (0.75,\y) ellipse (0.4 and 0.5);
  }
  
  % Card 2: 2 Striped ovals
  \foreach \y in {2.7,1.5} {
    \begin{scope}[yshift=\y]
      \clip (3.95,0) ellipse (0.4 and 0.5);
      \foreach \x in {3.4,3.55,...,4.5} {
        \draw[setred,line width=0.03cm] (\x,-0.7) -- (\x,0.7);
      }
    \end{scope}
    \draw[setred,line width=0.07cm] (3.95,\y) ellipse (0.4 and 0.5);
  }
  
  % Card 3: 2 Full ovals (solid)
  \foreach \y in {2.7,1.5} {
    \fill[setred] (7.15,\y) ellipse (0.4 and 0.5);
    \draw[setred,line width=0.07cm] (7.15,\y) ellipse (0.4 and 0.5);
  }
\end{tikzpicture}