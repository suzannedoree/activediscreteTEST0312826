% Used in \Cref{fig_SET_2SPO}.

\begin{tikzpicture}[x=1.2cm,y=1.2cm]
  \definecolor{setpurple}{RGB}{128,0,192}
  
  % Card background
  \draw[rounded corners=0.15cm,line width=0.05cm] (0,0) rectangle (3,4);
  
  % Label
  \node[font=\tiny\ttfamily] at (0.25,3.75) {2SPO};
  
  % Draw 2 striped ovals
  \foreach \i in {0,1} {
    % Oval body with stripes
    \begin{scope}[yshift={3.0-\i*1.2}]
      \clip (0.75,0) ellipse (0.5 and 0.65);
      \foreach \x in {-0.2,-0.05,...,1.0} {
        \draw[setpurple,line width=0.04cm] (\x,-0.8) -- (\x,0.8);
      }
    \end{scope}
    % Outline
    \draw[setpurple,line width=0.08cm] (0.75,{3.0-\i*1.2}) ellipse (0.5 and 0.65);
  }
\end{tikzpicture}