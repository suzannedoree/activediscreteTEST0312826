% Used in \Cref{figure_set_game_2cards}.

\begin{tikzpicture}[x=1.2cm,y=1.2cm]
  \definecolor{setred}{RGB}{192,0,0}
  
  % Card background
  \draw[rounded corners=0.15cm,line width=0.05cm] (0,0) rectangle (3,4);
  
  % Label
  \node[font=\tiny\ttfamily] at (0.25,3.75) {3NRQ};
  
  % Draw 3 open squiggles
  \foreach \i in {0,1,2} {
    \draw[setred,line width=0.08cm] 
      (0.2,{3.1-\i*0.9}) .. controls (0.35,{3.35-\i*0.9}) and (0.5,{3.05-\i*0.9}) ..
      (0.65,{3.2-\i*0.9}) .. controls (0.8,{2.95-\i*0.9}) and (0.95,{3.15-\i*0.9}) ..
      (1.1,{3.0-\i*0.9});
  }
\end{tikzpicture}