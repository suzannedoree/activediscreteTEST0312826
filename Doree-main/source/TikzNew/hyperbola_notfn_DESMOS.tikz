% Used in \Cref{fig_hyperbola_notfn_DESMOS}.

\begin{tikzpicture}[x=0.8cm,y=0.8cm]
  \draw[->] (-3.4,0) -- (3.4,0) node[right] {$x$};
  \draw[->] (0,-2.8) -- (0,2.8) node[above] {$y$};
  \draw[domain=1.05:3,samples=120,smooth] plot (\x,{sqrt(\x*\x-1)});
  \draw[domain=1.05:3,samples=120,smooth] plot (\x,{-sqrt(\x*\x-1)});
  \draw[domain=-3:-1.05,samples=120,smooth] plot (\x,{sqrt(\x*\x-1)});
  \draw[domain=-3:-1.05,samples=120,smooth] plot (\x,{-sqrt(\x*\x-1)});
  \draw[dashed] (2,-2.6) -- (2,2.6);
  \fill (2,1.732) circle (0.06);
  \fill (2,-1.732) circle (0.06);
\end{tikzpicture}