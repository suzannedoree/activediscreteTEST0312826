% B_1
\begin{tikzpicture}
[scale =.45, auto=left]
\GraphInit[vstyle=Welsh]
\SetGraphUnit{2}
\SetVertexNoLabel
% Root
\Vertex[x=3,y=4]{0}
% Children
\Vertex[x=2,y=2]{00}
\Vertex[x=4,y=2]{01}
% Edges
\Edges(0,00)
\Edges(0,01)
\end{tikzpicture}
