\begin{tikzpicture}
[scale =.55, auto=left]
\GraphInit[vstyle=Welsh]
\SetGraphUnit{1.6}
\SetVertexNoLabel
%\node at (0,3) {$G_3$};
\Vertices{circle}{$y$,$z$,$v$,$w$,$x$}
\Edges( $y$,$z$,$v$,$w$,$x$,$y$)
\Edges($z$,$x$,$v$,$z$)
\Edges($y$,$w$)
\end{tikzpicture}
\hspace{1in} %%%%%
\begin{tikzpicture}
[scale =.55, auto=left]
\GraphInit[vstyle=Welsh]
\SetGraphUnit{1.6}
\SetVertexNoLabel
%\node at (0,3) {$G_4$};
\Vertices{circle}{$y$,$z$,$v$,$w$}
\Vertex[LabelOut,Lpos= 90,x=0,y=0]{$x$}
\Edges( $y$,$z$,$v$,$w$,$x$,$y$)
\Edges($z$,$x$,$v$,$z$)
\Edges($y$,$w$)
\end{tikzpicture}
