% Used in \Cref{fig_lockers}.

\begin{tikzpicture}[x=0.9cm,y=0.9cm,line width=0.4pt]
  % Outer frame and locker dividers.
  \draw (0,0) rectangle (8,3);
  \foreach \x in {1,2,3,4,5,6,7} {
    \draw (\x,0) -- (\x,3);
  }

  % Locker labels, handle marks, and vent lines.
  \foreach \n in {1,2,3,4,5,6,7,8} {
    \pgfmathtruncatemacro{\m}{\n-1}
    \node[font=\scriptsize] at (\m+0.5,2.7) {00\n};
    \draw (\m+0.5,1.55) -- (\m+0.5,1.85);
    \draw (\m+0.12,0.95) -- (\m+0.88,0.95);
    \draw (\m+0.12,0.78) -- (\m+0.88,0.78);
    \draw (\m+0.12,0.61) -- (\m+0.88,0.61);
  }

  % Rightward continuation arrow.
  \draw[->] (8.25,1.7) -- (9.85,1.7);
\end{tikzpicture}