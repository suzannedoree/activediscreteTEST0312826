% Used in \Cref{fig_graph_10nplus1}.

\begin{tikzpicture}[x=0.6cm,y=0.11cm]
  % Left: discrete graph on N.
  \begin{scope}[shift={(0,0)}]
    \draw[->] (-0.4,0) -- (6.4,0) node[right] {$n$};
    \draw[->] (0,-1) -- (0,58) node[above] {$g(n)$};
    \foreach \n in {0,1,2,3,4,5} {
      \pgfmathsetmacro{\y}{10*\n+1}
      \fill (\n,\y) circle (0.09);
    }
    \draw[dashed] (0,1) -- (5.3,54);
    \node[font=\scriptsize] at (2.6,56) {$\mathbb{N}\to\mathbb{N}$};
  \end{scope}

  % Right: continuous graph on R.
  \begin{scope}[shift={(9.2,0)}]
    \draw[->] (-3.4,0) -- (3.4,0) node[right] {$x$};
    \draw[->] (0,-31) -- (0,31) node[above] {$f(x)$};
    \draw[domain=-3:3,samples=2,smooth] plot (\x,{10*\x+1});
    \node[font=\scriptsize] at (0,28) {$\mathbb{R}\to\mathbb{R}$};
  \end{scope}
\end{tikzpicture}