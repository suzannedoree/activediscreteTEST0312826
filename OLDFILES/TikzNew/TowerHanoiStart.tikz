% Used in \Cref{fig_hanoi_start_end}.

\begin{tikzpicture}[x=0.9cm,y=0.9cm,line width=0.8pt]
  % Pegs and bases.
  \draw[line width=1.2pt] (0,0) -- (2.8,0);
  \draw[line width=1.2pt] (3.1,0) -- (5.9,0);
  \draw[line width=1.2pt] (6.2,0) -- (9.0,0);
  \draw[line width=1.2pt] (1.4,0) -- (1.4,2.6);
  \draw[line width=1.2pt] (4.5,0) -- (4.5,2.6);
  \draw[line width=1.2pt] (7.6,0) -- (7.6,2.6);

  % Five disks stacked on tower 1.
  \fill[green!75!black] (0.45,0.00) rectangle (2.35,0.30);
  \fill[blue!80] (0.60,0.30) rectangle (2.20,0.58);
  \fill[violet!70!black] (0.75,0.58) rectangle (2.05,0.82);
  \fill[pink!60] (0.90,0.82) rectangle (1.90,1.06);
  \fill[pink!35] (1.05,1.06) rectangle (1.75,1.30);
  \draw (0.45,0.00) rectangle (2.35,0.30);
  \draw (0.60,0.30) rectangle (2.20,0.58);
  \draw (0.75,0.58) rectangle (2.05,0.82);
  \draw (0.90,0.82) rectangle (1.90,1.06);
  \draw (1.05,1.06) rectangle (1.75,1.30);

  \node[font=\bfseries\scriptsize] at (1.4,-0.2) {TOWER 1};
  \node[font=\bfseries\scriptsize] at (4.5,-0.2) {TOWER 2};
  \node[font=\bfseries\scriptsize] at (7.6,-0.2) {TOWER 3};
\end{tikzpicture}