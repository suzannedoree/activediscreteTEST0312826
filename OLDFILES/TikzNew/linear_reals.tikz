% Used in \Cref{fig_graph_10xplus1}.

\begin{tikzpicture}[x=1cm,y=0.11cm]
  \begin{scope}[shift={(0,0)}]
    \draw[->] (-3.4,0) -- (3.4,0) node[right] {$x$};
    \draw[->] (0,-31) -- (0,33) node[above] {$y$};
    \foreach \n in {-3,-2,-1,1,2,3} {
      \draw (\n,-1.5) -- (\n,1.5) node[below=10pt] {$\n$};
    }
    \foreach \y in {-30,-20,-10,10,20,30} {
      \draw (-0.12,\y) -- (0.12,\y) node[left=4pt] {$\y$};
    }
    \draw[domain=-3:3,samples=2,smooth] plot (\x,{10*\x+1});
  \end{scope}
\end{tikzpicture}