%% K
\begin{tikzpicture}
    [scale =.35]
    \GraphInit[vstyle=Welsh]
    \SetGraphUnit{1.6}
    %\SetVertexNoLabel
        \node at (3,6) {$K$};
    % new top row
    \Vertex[LabelOut,Lpos=-90,x=4,y=0]{$a$}
    % next layer
    \Vertex[LabelOut,Lpos= 90,x=0,y=3]{$b$} 
    \Vertex[LabelOut,Lpos= 90,x=6,y=3]{$y$} 
    % leaves  
    \Vertex[LabelOut,Lpos=-90,x=8,y=0]{$c$} 
    \Vertex[LabelOut,Lpos=-90,x=0,y=0]{$z$}
    % edges
    \Edges($a$,$y$,$c$)
    \Edges($b$,$z$)
    \Edges($b$,$y$)
\end{tikzpicture}