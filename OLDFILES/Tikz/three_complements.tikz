% C_4 with dot in middle
\begin{tikzpicture}
    [scale =.5]
    \GraphInit[vstyle=Welsh]
    \SetGraphUnit{2}
    %\SetVertexNoLabel
    \node at (1.5,-4) {$J$};
    \Vertex[LabelOut,Lpos=135,x=0,y=1.5]{$a$}
    \Vertex[LabelOut,Lpos=45,x=3,y=1.5]{$b$} 
    \Vertex[LabelOut,Lpos=-45,x=3,y=-1.5]{$c$}
    \Vertex[LabelOut,Lpos=-135,x=0,y=-1.5]{$d$}
    \Vertex[LabelOut,Lpos=90,x=1.5,y=0]{$x$}
    \Edges($a$,$b$,$c$,$d$,$a$)
\end{tikzpicture}