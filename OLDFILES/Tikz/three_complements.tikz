%Used in \Cref{sec_graph_models}

% P4
\begin{tikzpicture}
    [scale =.5]
    \GraphInit[vstyle=Welsh]
    \SetGraphUnit{2}
    %\SetVertexNoLabel
    \node at (2.25,-4) {$G$};
    \node at (2.25,4) {}; % to raise graph
    \Vertex[LabelOut,Lpos=90,x=0,y=0]{$a$}
    \Vertex[LabelOut,Lpos=90,x=1.5,y=0]{$b$} 
    \Vertex[LabelOut,Lpos=90,x=3,y=0]{$c$}
    \Vertex[LabelOut,Lpos=90,x=4.5,y=0]{$d$}
    \Edges($a$,$b$,$c$,$d$)
\end{tikzpicture}
%%%%%%%%%%%%%
\hspace{.35in}
%%%%%%%%%%%%%
% C5
\begin{tikzpicture}
    [scale =.5]
    \GraphInit[vstyle=Welsh]
    \SetGraphUnit{2}
    %\SetVertexNoLabel
    \node at (0,-4) {$H$};
    \Vertices{circle}{$a$,$b$,$c$,$d$,$e$}
    \Edges($a$,$b$,$c$,$d$,$e$,$a$)
\end{tikzpicture}
%%%%%%%%%%%%%
\hspace{.35in} 
