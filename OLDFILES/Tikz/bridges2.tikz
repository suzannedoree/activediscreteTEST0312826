\begin{tikzpicture}

% Define the bounding box
\draw (0,0) rectangle (10,6);

% Draw the shores
\draw[thick] plot[smooth] coordinates {(0,5) (3,5.2) (6,4.5) (10,5.2)};
\draw[thick] plot[smooth] coordinates {(0,1) (3,0.8) (6,1.5) (10,0.8)};

% Draw the islands
\draw[fill=white] plot[smooth cycle] coordinates {(0.5,3) (1,4) (2.5,4) (2.5,2.5) (1,2.5)};
\node at (1.5, 3.25) {Small Island};

\draw[fill=white] plot[smooth cycle] coordinates {(5.5,4) (7,4.2) (9,3.5) (9,2) (7,1.8) (5.5,2.5)};
\node at (7.25, 3) {Big Island};

% Draw the bridges (thick black rectangles)
\fill (1.2,5.2) rectangle (1.4,4); % Bridge 1
\fill (1.5,2.5) rectangle (1.7,1.8); % Bridge 2
\fill (2.5,3.1) rectangle (5.5,3.3); % Bridge 3 (center)
\fill (5.6,5.1) rectangle (5.8,4); % Bridge 4
\fill (8,4.2) rectangle (8.2,5.1); % Bridge 5
\fill (7.5,1.8) rectangle (7.7,1); % Bridge 6

% Add labels
\node at (5, 5.5) {North Shore};
\node at (2.5, 0.5) {South Shore};

% Add water ripples (simplified)
\foreach \x in {0.5, 1.5, ..., 9.5} {
\foreach \y in {0.5, 1.5, ..., 5.5} {
\node[font=\tiny] at (\x, \y) {$\sim$};
}
}

\end{tikzpicture}